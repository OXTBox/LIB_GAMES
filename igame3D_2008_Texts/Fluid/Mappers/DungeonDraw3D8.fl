function Mapper_menu_callback(w)
if BtnBrowser == nil then return end;
tMenu = w:label()
tVal = w:value()
tPick = w:text()

tIndex = MapperMenuIndex[tVal]
tIndex1 = MapperMenuIndex[tVal-1]
tIndex2 = MapperMenuIndex[tVal+1]

	if tIndex ~=nil  then 
	MappermenuHead=item(1,tIndex,"/")
print(MappermenuHead)
 		if MappermenuHead == "File" then MapperBrowsersMenuPick(tPick) end;
 		if MappermenuHead == "Maps" then MapperCurrentPick(tPick) end;
 		if MappermenuHead == "All" 	then  MapperAllMenuPick(tPick) end;
 		
 	 end 
 	 if tIndex1 == "All/Clear" then MapperAllMenuPick("Clear") end
 	 if tIndex1 == "Current/Clear" then MapperCurrentPick("Clear") end
  Fl:check();
   io.flush();
end

function Mapper_MenuBarFill()
if BtnBrowser == nil then return end;
fillMapperSourceMenu()
fillMapperControlMenu()
end} {}
  Fl_Window BtnBrowser {
    callback wClose open
    xywh {6 50 143 78} type Double visible
  } {
    Fl_Menu_Bar MapperMenu {
      callback Mapper_menu_callback selected
      xywh {-5 -2 150 22} color 38 labelsize 10 textsize 10
    } {}
    Fl_Browser BtnListBrowser {
      xywh {0 30 50 25} type Hold labelsize 10 textsize 10
    }
    Fl_Browser AttrListBrowser {
      xywh {50 30 85 25} type Hold labelsize 10 textsize 10
    }
  }
  Fl_Window MapTextWindow {
    callback wClose open
    xywh {214 631 329 263} type Double hide resizable size_range {329 263 331 579}
  } {
    Fl_Browser MapTextFld {
      xywh {0 0 330 576} type Hold labelsize 9 textsize 10 resizable
    }
  }
