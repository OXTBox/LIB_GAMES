	if (evt) then

	--out:value(evt .. "   " .. murgaLua.getFltkEventText(evt))

		if (evt == 7) then tCount = 99999999 end

dragGrid(DWindow)
	end

    --DWindow:redraw()

    timer:doWait(0.1)

end} {selected
