} {
  code {-- globals_and_functions_codeblock
counter=95 
houseGrid={{32,32}}

objectGrid={}
col,row = 1,1
entityColor=5
esize=2
ep=0




function mapDrop(mx,my)
	nx,ny=mx,my

			for i=1,6,1 do
			
			if i*64 > mx then 
				nx=(i*64)-32
				col=i
				break
			 end
			end

			for i=1,6,1 do
			
			 if i*64 > my then 
				ny=(i*64)-32
				row=i
				break
			 end
			end
	put=0
	fltk.fl_rectf(nx,ny,esize,esize)
	
	for i = 1,\#houseGrid,1 do
	co=houseGrid[i][1]..","..houseGrid[i][2]
	cn=nx..","..ny
		if co==cn then
		print("notempty"..houseGrid[i][1],houseGrid[i][2])
		put=1
		break
		end
	end
	
	if put == 0 then table.insert(houseGrid,{nx,ny}) end	
	
end


function drawBox(w)
DWindow:make_current();
fltk.fl_color(entityColor)
	if Fl:event()==1  then
	mx,my=Fl:event_x(),Fl:event_y()
		if esize ~= 8 then 
		fltk.fl_rectf(mx,my,esize,esize)  
		else
		mapDrop(mx,my)
		end
	
	end
end
	






function drawrectF(qx,qy,qs)
color_cycle(1,255,5)
quadHalf=math.floor(qs/2)
l,t =qx-quadHalf,qy-quadHalf
fltk.fl_rectf(l,t,qs,qs)
end} {}
  code {-- Generate Temporary Grid
tempGrid={}

function dragGridLong()
	if Fl:event()==1 or Fl:event()==5 then
	DWindow:make_current();
	
	mx,my=Fl:event_x(),Fl:event_y()
   

	tempGrid={}
	for i = 1,384-mx,mx do
		for ii = 1,384-my,my do
		table.insert(tempGrid,{i,ii})
		
		fltk.fl_color(math.random(1,255))
		fltk.fl_rectf(i, ii, mx,my)  
		
		
		end
	end
	end
	
	

end

function idleDrag()
DWindow:make_current();
end

function dragGrid(w)
if Fl:event()==1 or Fl:event()==5 then

	DWindow:make_current();
	mx,my=Fl:event_x(),Fl:event_y()
	
        rx,ry=(mx/6), (my/6)
      
        

	tempGrid={}
	local n=0
	for i = 1,384,rx do
		for ii = 1,384,ry do
		table.insert(tempGrid,{i,ii})
		n=n+1
		fltk.fl_color(math.random(1,255))
		--tstring="do newblock"..n.."=fltk.fl_rectf("..i ..","..ii..","..rx..","..ry..") end\\n"; 
		fltk.fl_rectf(i, ii, rx,ry)  
		--print(tstring)
		--loadstring(tstring)
		end
	end
	

	
end
end} {}
