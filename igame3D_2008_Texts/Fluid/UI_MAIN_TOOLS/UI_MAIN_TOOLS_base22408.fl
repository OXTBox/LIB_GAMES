  code {-- Fast FilePaths, creates directories

function fastFilePaths(ft,whatExt)
fastPath=gameroot.."Data/"..ft
ig3d_CreateDirectory_s(fastPath)
fastFile=fastPath.."/"..os.time()..whatExt
return fastFile
end} {}
