  code {--  CameraBrowserValueCatch
function CameraBrowserValueCatch()
CameraFieldValues[1]=CameraListBrowser:value()
CameraFieldValues[2]=CameraAttListBrowser:value()
CameraFieldValues[3]=CameraAttListBrowser:value()

CameraFieldValues[4]=wtfFileBrowser:value()
CameraFieldValues[5]=CameraBoolBtn:value()
CameraFieldValues[6]=CameraValInputA:value()
CameraFieldValues[7]=CameraNameInput:value()

CameraFieldValues[8]=CameraMaterialsBrowser:value()
CameraFieldValues[9]=CameraMaterialsAttributesBrowser:value()
CameraFieldValues[10]=CameraFieldValues[9]
CameraFieldValues[11]=CameraMaterialsBoolBtn:value()
curValBool = gCameraValueItems[1]
	if curValBool ~= "true" and curValBool ~= "false" then 	
	curValBool = nil
	end	
	
gNewCameraValueItems={}	
for i=1,\#gCameraValueItems,1 do
  if i == 1 then
	if curValBool == nil then
 	
 	table.insert(gNewCameraValueItems,CameraValInputA:value());
 	else
 	table.insert(gNewCameraValueItems,curValBool);
 	end
 	end
 
	if i == 2 then 
	if curValBool == nil then
 	table.insert(gNewCameraValueItems,CameraValInputB:value());
 	else
 	table.insert(gNewCameraValueItems,CameraValInputA:value());
 	end
 	end
 
	if i == 3 then 
	if curValBool == nil then
 	table.insert(gNewCameraValueItems,CameraValInputC:value());
 	else
 	table.insert(gNewCameraValueItems,CameraValInputB:value());
 	end
 	end
 	
	if i == 4 then 
	if curValBool == nil then
 	table.insert(gNewCameraValueItems,CameraValInputD:value());
	else
 	table.insert(gNewCameraValueItems,CameraValInputC:value());
 	end
 	end		
end

gNewCameraMaterialsValueItems={}
if gCameraMaterialsValueItems[1] =="true" or gCameraMaterialsValueItems[1] =="false" then
table.insert(gNewCameraMaterialsValueItems,CameraFieldValues[11])
else
for i=1,\#gCameraMaterialsValueItems,1 do
  if i == 1 then
 	table.insert(gNewCameraMaterialsValueItems,CameraMaterialsValInputA:value());
 	end
 
	if i == 2 then 
 	table.insert(gNewCameraMaterialsValueItems,CameraMaterialsValInputB:value());
 	end
 
	if i == 3 then 
 	table.insert(gNewCameraMaterialsValueItems,CameraMaterialsValInputC:value());
 	end
 	
	if i == 4 then 
 	table.insert(gNewCameraMaterialsValueItems,CameraMaterialsValInputD:value());
 	end		
end
end

 fltk_update()
end} {}
  code {-- parseHelpForAttributes

function parseHelpForCameraAttributes()
CameraBrowserValueCatch()
whichCommand = "getCameraInfo"
whichElement = ""
q= string.char(34); --quotation mark;
pc = string.char(37); --percent sign;
gFoundAttributes={"name","position","rotation","size","coll","hud"}
        pslist = ""
	for i = 1,\#gFoundAttributes,1 do
	pslist = pslist..gFoundAttributes[i].."\\n"
	end
	slist=pslist
	shText=tText
	f=io.open(gameroot.."Data/Help/scripting.txt", "r")
	tText=f:read("*a")
	f:close()	
	-- get one underscores 
	firstMatch = whichCommand..pc.."p"....pc.."sIG3D_"..pc.."u+."..pc..")"..pc..":";
 	for s in string.gmatch(tText,firstMatch) do 	
 		shText = string.sub(s,string.len(whichCommand.."(".."IG3D_")+1,-1)
 		shText = string.sub(shText,1,string.find(shText,")")-1)

		 if string.find(slist,string.lower(shText)) == nil then
		 slist = slist..shText.."\\n"
 		 table.insert(gFoundAttributes,string.lower(shText))
 		 end
 	 end
 	-- get two underscores 	
   	secondMatch = whichCommand..pc.."p"..pc.."sIG3D_"..pc.."u+"..pc.."_"..pc.."u+"..pc..")";
		for s in string.gmatch(tText,secondMatch) do 
 			shText = string.sub(s,string.len(whichCommand.."(".." IG3D_")+1,-1)
 			shText = string.sub(shText,1,string.find(shText,")")-1)

	 		if string.find(slist,string.lower(shText)) == nil then
	 		slist = slist..shText.."\\n"
 	 		table.insert(gFoundAttributes,string.lower(shText))
 	 		end
		end	
end} {}
  code {-- parseCameraAttributesTable
function parseCameraAttributesTable(whichCommand, whichElement)
		gCameraDetailsInfo={}
		gCameraInfoAttributes={}
		gCameraAttVars={{}}
		whichCommand = "getCameraInfo"
		whichElement = "obj"
		gCameraGetInfoTable={}
		local tally=""
		for i =1,\#gFoundAttributes,1 do
		ts = "IG3D_"..string.upper(gFoundAttributes[i])
		table.insert(gCameraInfoAttributes,ts)
		thirdMatch = whichCommand..pc.."p"..ts..pc..")"..pc..":"..pc.."("..".+";
		tk = string.match(tText,thirdMatch,1)
		if tk ~= nil then 
		tmsub=string.sub(tk,string.len(whichCommand.."("..ts.."):(")+1, string.find(tk,"\\n")-2)
		
		-- insert model info attributes
		table.insert(gCameraAttVars ,tmsub)
		-- temp strings
		tmsur=tmsub
		its=tmsub
			if string.find(tmsur,",") ~= nil then
			its=""
			mn=0
			for items in string.gmatch(tmsub, pc.."a+") do
			fc=string.find(tmsur,",")
				if fc ==nil then fc =0 end
				its=its..string.sub(tmsur,1,fc-1)..","
				tmsur=string.sub(tmsur,fc+1,-1)
				mn=mn+1
				end
			end
			
			-- insert commands to get info as strings
			tmas=  tmsub.."="..whichCommand.."("..ts.." )"
			tally =tally.. tmas .. "\\n"
			table.insert(gCameraGetInfoTable,tmas)
			-- insert command to insert retrieved info into table  
			tmai = "table.insert(gCameraDetailsInfo,{"..tmsub.."} )"
			table.insert(gCameraGetInfoTable,tmai)	
	end
	end
	--print(tally)
	
end} {}
  code {-- updateCameraAttributesTables
function updateCameraAttributesTables()
gCameraDetailsInfo={}
executeTable(gCameraGetInfoTable) 	
		
	gSelCameraData={}

	for i=1,\#gCameraDetailsInfo,1 do
	sou=""
		for ii=1,\#gCameraDetailsInfo[i],1 do
		if gCameraDetailsInfo[i][ii] ~= nil then
		sou=sou..tostring(gCameraDetailsInfo[i][ii])..","
		end
		end
		sout = string.sub(sou,1,-2)	
	table.insert(gSelCameraData, sout)
	end
	
	
	gCameraAttributes={}
	for i=1,\#gFoundAttributes,1 do
	table.insert(gCameraAttributes,gFoundAttributes[i])
	end
	
	
end} {}
  code {-- showCameraColorChooser
function showCameraColorChooser()
	colorChooserLabel = gSelectedMaterialAttributes[gSelectedMaterialAttribute]
	choosr,choosg,choosb= (gRed * 255) , (gGreen * 255), (gBlue *255)
	color_ok, choosr, choosg , choosb = fltk.fl_color_chooser(colorChooserLabel,choosr,choosg,choosb)	
	
	if color_ok == 1 then -- color_ok represents the first value (exit status) returned by fl_color_chooser
	Fl:set_color(15,choosr,choosg,choosb) -- change color 15
 	gRed, gGreen, gBlue = (choosr) / 255.0, (choosg) / 255.0, (choosb) / 255.0
 		
	CameraMaterialsValInputA:value(tonumber(string.sub(gRed,1,4)))
	CameraMaterialsValInputB:value(tonumber(string.sub(gGreen,1,4)))
	CameraMaterialsValInputC:value(tonumber(string.sub(gBlue,1,4)))
	
	CameraBrowserValueCatch()
	local lVal = ""	
	for i=1,\#gNewCameraMaterialsValueItems,1 do
	lVal = lVal..gNewCameraMaterialsValueItems[i]..","
	end
	changeCameraMaterialsVal(string.sub(lVal,1,-2));

		
	end
end} {}
  code {-- CameraBrowserWindowUpdate
function CameraBrowserWindowUpdate(arg)
 if CameraBrowser == nil then return end
 CameraBrowser:make_current()
 CameraBrowserValueCatch()
  
 local i = 1
 local FBn,EBLn,EAn = nil,nil,nil
 EAn= CameraFieldValues[2]
CameraBrowserGroupsHide()
 ---- SourceList 
		if arg == "SourceList" then
	local FBn = wtfFileBrowser:value()
		wtfFileBrowser:clear() 
  			for i=1,\#gCameraFilesShortNames,1 do
			wtfFileBrowser:add(gCameraFilesShortNames[i])
			end
		end
---- CurCameraInfo	
		if arg == "CurCameraInfo" then
			if gCameraourcePath ~= nil then  
				local ss,se = string.find(gCameraourcePath,"Data/WTF/")
				if se ~= nil then 
				local curCameraName = string.sub(gCameraourcePath,se+1,-1)
				SourceNameInput:value(curCameraName)
				SourceNameInput:redraw()
				end;	
			end;
			updateCameraAttributesTables()
				
			 if \#gSelCameraData > 1 then 
			 EAn = CameraFieldValues[2]
			 EBLn = CameraFieldValues[1]
				
				CameraAttListBrowser:clear()
				CameraValueListBrowser:clear()
				
				
			        local i = 1
				for i = 1,\#gCameraAttributes,1 do
				CameraAttListBrowser:add(gCameraAttributes[i])
				CameraAttListBrowser:redraw()
				end
				
				for i = 1,\#gSelCameraData,1 do
				CameraValueListBrowser:add(gSelCameraData[i])
				gOldInfo = gSelectedCameraInfo
				end
				
			end
			
	
	
			
				
		end; -- if_curCamerainfo
		
---- updateCameraListBrowser 		
		if arg == "updateCameraListBrowser" then
		if \#gCameraNames > 0  then
		 EBLn = CameraFieldValues[1]
			  CameraListBrowser:clear()
			  for i=1,\#gCameraNames,1 do 
			  CameraListBrowser:add(gCameraNames[i])	
			 	 if gSelectedCamera == gCameraNames[i] then EBLn = i end;
			  end
		gSourceRequest = ""
		else
		
		end	
		end;
		  

	
	if arg == "newCamera" then
		CameraAttListBrowser:value(2)
		CameraValueListBrowser:value(2)
		CameraAttListBrowser:select(2)
		CameraValueListBrowser:select(2)
		CameraBrowserValueCatch()
	end
	
	if arg == "updateMaterialsBrowser" then
		

	end



---- SELECT LINE OF BROWSER  
				if FBn ~= nil then
				wtfFileBrowser:selected(FBn,FBn)
				wtfFileBrowser:value(FBn)
				wtfFileBrowser:select(FBn)
				wtfFileBrowser:redraw()
				end
		
				if EBLn ~= nil then
				CameraFieldValues[1] = EBLn
				gSelectedCamera = gCameraNames[EBLn] 
				 CameraListBrowser:select(EBLn,EBLn)
		 		CameraListBrowser:value(EBLn)
		 		CameraListBrowser:selected(EBLn)
				end
			if EAn ~= nil then 		 
			CameraAttListBrowser:select(EAn,EAn)
			CameraAttListBrowser:value(EAn)
			CameraAttListBrowser:selected(EAn)
			CameraValueListBrowser:select(EAn,EAn)
			CameraValueListBrowser:value(EAn)
			CameraValueListBrowser:selected(EAn) 
			
			end
fltk_update()
end} {}
  code {-- updateCameraListBrowser
function updateCameraListBrowser()
CameraBrowserValueCatch()
plist= ig3d_GetCamerasList__s()
if plist ~= nil then 
	gCameraNames={}
	
	pcount =  getlinecount(plist)
	if pcount == 0 and string.len(plist) ~=0 then 
	pcount = 1 
	plist = plist.."\\n"
	end
	
	if pcount ~= 0 then  
		for i=1,pcount,1 do		
		pname = getlineof(plist,i)
			
			if pname ~= nil then  
			table.insert(gCameraNames,pname)
			end;	
		end	
	end
	
	 
	end
	CameraBrowserWindowUpdate("updateCameraListBrowser")
	
end} {}
