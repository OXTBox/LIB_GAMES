  code {-- CameraSourceBrowserControlDoubleClicked
function CameraSourceBrowserControlDoubleClicked(w)
local theFile=gCameraBrowserFiles[tonumber(w:value())]
	if theFile[2]=="directory" then
		if theFile[1]==".." then 
			gCameraBrowserPath=goDirsUp(gCameraBrowserPath, 1)
		else
			gCameraBrowserPath=gCameraBrowserPath..theFile[1].."/"
			if theFile[1] ~= nil then gLastSourceDirectory=theFile[1] end
		end
		listWTFFiles()
	end
	
end} {}
  code {-- CameraSourcebrowserControlClicked



function CameraSourcebrowserControlClicked(w)
if w:value()==0 then return end
	local theFile=gCameraBrowserFiles[tonumber(w:value())]
	if theFile[2]=="file" then
		--updateWTFPreviewBox(theFile[1])
		
		gWTFReplacementFile = gLastSourceDirectory.. "/"..theFile[1]
		
		
		ReplaceWTFSourceBtn:label(gCameraShortPath.."\\nwith\\n"..gWTFReplacementFile)
	ReplaceWTFSourceBtn:show()
		ReplaceAllWTFSourceBtn:show()
	end
	local t=time()
	if t-gLastCameraSourceBrowserControlClick < 0.4 and w:value()==gLastCameraSourceSelection then
	CameraSourceBrowserControlDoubleClicked(w)
		gLastCameraSourceBrowserControlClick=0
	else
		gLastCameraSourceBrowserControlClick=time()
	end
	gLastCameraSourceSelection=w:value()	
end} {}
  code {-- ReplaceWTFSourceBtnClick
function ReplaceWTFSourceBtnClick()

fileName = gameroot..ig3d_GetLevelName__s().."/load script.lua"

	local f=io.open(fileName, "r")
	local tText=f:read("*a")
	f:close()
	q='"'
	
	s,ig = string.find(tText,"gCameraWTFs")
	se,ig = string.find(tText,"gCameraNames")
	
	refrsrc = string.sub(tText,s,se-1)
	
	loadstring(refrsrc) -- refreshes gCameraWTFs table
	
	gCameraWTFs[gCameraNum] = gWTFReplacementFile
	
	local tableout = "gCameraWTFs={"
	for i=1,\#gCameraWTFs,1 do
	tableout = tableout..q..gCameraWTFs[i]..q..","
	end
	
	tableout = string.sub(tableout,1,-2).."}"
	
	tText = string.gsub(tText,refrsrc,tableout)
	
	f=io.open(fileName,"w")
	
	f:write(tText)
	f:close()
	
	loadLevel(ig3d_GetLevelName__s())
end} {}
  code {-- ReplaceAllWTFSourceBtnClick
function ReplaceAllWTFSourceBtnClick()

fileName = gameroot..ig3d_GetLevelName__s().."/load script.lua"

local f=io.open(fileName, "r")
	local tText=f:read("*a")
	for repmatch in string.gmatch(tText,gCameraShortPath) do
	tText = string.gsub(tText,gCameraShortPath,gWTFReplacementFile,1)
	end
	
	f:close()
	f=io.open(fileName,"w")
	
	f:write(tText)
	f:close()
	
	loadLevel(ig3d_GetLevelName__s())
end} {}
  code {-- Camera MENU FUNCTIONS
CameraMenuIndex={}
CameraMenuText={}
CameraMenuText.Source={"Make", "Save","Duplicate"}
CameraMenuText.Control={"Run","Stop","Clear"}

function fillCameraSourceMenu()
if CameraBrowser == nil then return end;
	for  i=1,\#CameraMenuText.Source,1 do
	menuLine="Camera/"..CameraMenuText.Source[i]
	CameraMenu:add(menuLine);
	table.insert(CameraMenuIndex,menuLine)
	end
CameraMenu:add("");
table.insert(CameraMenuIndex,"")
CameraMenu:redraw()
end 

function fillCameraControlMenu()
if CameraBrowser == nil then return end;
for  i=1,\#CameraMenuText.Control,1 do
	menuLine="Current/"..CameraMenuText.Control[i]
	CameraMenu:add(menuLine);
	table.insert(CameraMenuIndex,menuLine)
	end
CameraMenu:add("");
table.insert(CameraMenuIndex,"")
CameraMenu:add("");
table.insert(CameraMenuIndex,"")
--All
for  i=1,\#CameraMenuText.Control,1 do
	menuLine="All/"..CameraMenuText.Control[i]
	CameraMenu:add(menuLine);
	table.insert(CameraMenuIndex,menuLine)
	end



CameraMenu:redraw()
end


function CameraCurrentPick(tPick)

		if tPick == "Clear" then
	
		render()
		end
		
		if tPick == "Run" then		
		
		render()
		end
		
		if tPick == "Stop" then		
	 
		render()
		end
end


function CameraBrowsersMenuPick(tPick)
if CameraBrowser == nil then return end;
CurCameraInfo()	
if tPick == "Save" then 
PickedCameraAttribute(2)
CameraInputGroup:hide()
CameraourceGroup:hide()
CameraValueGroup:hide()
CameraTextureGroup:hide()
CameraaveAsGroup:show()
end

if tPick == "Make" then
wtfFileBrowser:label(tPick)
gSourceRequest = tPick
PickedCameraAttribute(1)
ValueListBrowser:clear()
CameraInputGroup:hide()
CameraourceGroup:show()
CameraValueGroup:hide()
CameraTextureGroup:hide()
CameraaveAsGroup:hide()
CameraourceList()
CameraBrowserWindowUpdate("SourceList") --
end		
if tPick == "Duplicate" then MakeCamera() end;

end




function Camera_menu_callback(w)
if CameraBrowser == nil then return end;
tMenu = w:label()
tVal = w:value()
tPick = w:text()
tIndex = CameraMenuIndex[tVal]
tIndex1 = CameraMenuIndex[tVal-1]
tIndex2 = CameraMenuIndex[tVal+1]

	if tIndex ~=nil  then 
	CameramenuHead=item(1,tIndex,"/")

 		if CameramenuHead == "Camera" then CameraBrowsersMenuPick(tPick) end;
 		if CameramenuHead == "Current" then CameraCurrentPick(tPick) end;
 		if CameramenuHead == "All" 	then  CameraAllMenuPick(tPick) end;
 		
 	 end 
 	 if tIndex1 == "All/Clear" then CameraAllMenuPick("Clear") end
 	 if tIndex1 == "Current/Clear" then CameraCurrentPick("Clear") end
  Fl:check();
   io.flush();
end

function Camera_MenuBarFill()
if CameraBrowser == nil then return end;
fillCameraSourceMenu()
fillCameraControlMenu()
end} {}
