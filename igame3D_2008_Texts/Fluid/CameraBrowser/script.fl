	CameraValueListBrowser:add(getlineof(gSelectedCameraInfo,i));
	end
	end
	
--parseHelpForCameraAttributes()
--parseCameraAttributesTable("getCameraInfo","obj")	

gNumHelpedAttributes=\#gCameraAttributes

