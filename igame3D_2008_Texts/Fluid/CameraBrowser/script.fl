  code {-- CamerawtfAddCameraClicked
function CamerawtfAddCameraClicked(w)
	if wtfFileBrowser:value()==0 then return end
	local theFile=gCameraBrowserFiles[tonumber(wtfFileBrowser:value())]
	if theFile[2]=="directory" then return end
	
	local c=\#(gameroot.."Data/WTF/")+1
	local newObj={}
	table.insert(gCameras, newObj)
	local n=\#gCameras
	gDropCamera = string.sub(gCameraBrowserPath..theFile[1],c,-1)
	gCameras[n].cObj=make(ig3d_camera, gDropCamera)
	updateCameraListBrowser()
	
end} {}
