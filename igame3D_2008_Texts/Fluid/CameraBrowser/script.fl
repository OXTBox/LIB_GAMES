  code {-- changeCameraVal
function changeCameraVal(PValue)
if CameraBrowser == nil then return end;
CameraBrowserValueCatch()
changeLine = CameraFieldValues[2]
setVal=""
gSelectedCameraInfo = CurCameraInfo()
curData = gSelCameraData[changeLine]
currentCameraVal = gCameraValues[changeLine]

gSelCameraData[changeLine] = PValue

local tally =""
for i=1,4,1 do
setVal = setVal .. gSelCameraData[i].."\\n"
end
ig3d_SetCameraInfo_2s(gObjName,setVal)

for i=1,\#gSelCameraData,1 do
if i<\#gCameraInfoAttributes and i < \#gSelCameraData  then
setObjString ="setCameraInfo(gCameras["..gCameraNum.."].cObj,"..gCameraInfoAttributes[i]..","..gSelCameraData[i]..")"
tally = tally..setObjString.."\\n"
end
end

--print(tally)

CameraBrowserValueCatch()
CurCameraInfo()
				

end} {}
  code {-- CameraValInput

function CameraValInput(w)
	if CameraBrowser == nil then return end;
	CameraBrowserValueCatch()
	local lVal = ""	
		for i=1,\#gNewCameraValueItems,1 do
		lVal = lVal..gNewCameraValueItems[i]..","
		end
	changeCameraVal(string.sub(lVal,1,-2));
end} {}
  code {-- changeCameraBool
function changeCameraBool(w)
if CameraBrowser == nil then return end;
CameraBrowserValueCatch()
changeLine = CameraFieldValues[2]

gSelectedCameraInfo = CurCameraInfo()

	if w:value() == 1 then 
		tBool = "true"
	else
		tBool = "false"
	end

gSelCameraData[changeLine] = tBool

ses= "setCameraInfo("..gCameraInfoAttributes[changeLine]..","..gSelCameraData[changeLine]..")"
local code,error = loadstring(ses)
if error == nil then code() end

CurCameraInfo()
fltk_update()
end} {}
  code {-- PickCameraDetails
function PickCameraDetails()
CameraBrowserValueCatch()
AttributeLine = gCameraAttributes[CameraFieldValues[2]]


if AttributeLine == "bones" then CameraBonesGroup:show()
elseif AttributeLine == "materials" then CameraMaterialsGroup:show()
elseif AttributeLine == "source" then listWTFFiles () 
end

end} {}
  code {-- PickedCameraAttribute
function PickedCameraAttribute(n)
if CameraBrowser == nil then return end;
CameraBrowserValueCatch()
if n == nil then n = CameraFieldValues[2] end
if n == nil then return end

gSelectedCameraInfo = CurCameraInfo()
             
CameraBrowserGroupsHide()		
CameraNameInput:value(gCameraValues[1]) 
-- Path to Source
if n == 9999 then 
CameraBrowserWindowUpdate("SourceList")
gSourceRequest = "Replace"
wtfFileBrowser:label("Replace Camera Source")
CameraSourceGroup:show()
wtfFileBrowser:value(CameraFieldValues[4])
wtfFileBrowser:select(CameraFieldValues[4])
CameraSourceGroup:redraw()
 end
 

if gCameraToolTipPicked =="translate" then 

	CameraValueGroup:show()
	CameraInputGroup:show() 
	CameraNameInput:hide()
	CameraValInputA:hide()
	
	if n == 1 or CameraFieldValues[2] == 1 then 
	-- Camera NAME
	CameraInputGroup:show()  
	CameraNameInput:show()
	CameraNameInput:value(gSelCameraData[1])
	CameraValInputA:hide()
	end



	
if n > 1 then 

	gCameraValueItems={}
	curVal = gSelCameraData[n]
	curValBool=curVal
	curValF=""
	sstr = nil
	-- COMMAS
	if curVal ~= nil then 
	fc=string.find(curVal,",")
		if fc == nil then 
		
		table.insert(gCameraValueItems,curVal)
		else
			for i = 1, numberofitems(curVal,","), 1 do
			local va=item(i,curVal,",")
			
			table.insert(gCameraValueItems,va)
			end
		end
		
	end	


if \#gCameraValueItems == 1 then 
		CameraValInputA:hide()
		CameraValInputB:hide()
		CameraValInputC:hide()
		CameraValInputD:hide()
		end
-- BOOLS
curValBool = gCameraValueItems[1]
	if curValBool == "true" or curValBool == "false" then 	
	CameraBoolBtn:show()
	CameraBoolBtn:label(gCameraAttributes[n])
		if string.len(curValF) >1  then 
		CameraValInputA:show()
		CameraValInputA:value(tonumber(curValF))
		else
		CameraValInputA:hide()
		end
	else
	if n ~= 1 then 
	CameraValInputA:value(tonumber(curValBool))
	CameraValInputA:show()
	end
	CameraBoolBtn:hide()
	curValBool = nil
	end	
		
	if curValBool == "true" then
	CameraBoolBtn:value(1)
	else
	CameraBoolBtn:value(0)
	end
	
for i=1,\#gCameraValueItems,1 do
cCameraValueItem = tonumber(gCameraValueItems[i])
  if i == 1 then
	if curValBool == nil then
 	CameraValInputA:show()
 	CameraValInputA:value(cCameraValueItem)
 	end
 	end
 
	if i == 2 then 
	if curValBool == nil then
	CameraValInputB:show()
 	CameraValInputB:value(cCameraValueItem)
 	else
 	CameraValInputA:show()
 	CameraValInputA:value(cCameraValueItem)
 	end
 	end
 
	if i == 3 then 
	if curValBool == nil then
	CameraValInputC:show()
 	CameraValInputC:value(cCameraValueItem)
 	else
 	CameraValInputB:show()
 	CameraValInputB:value(cCameraValueItem)
 	end
 	end
 	
	if i == 4 then 
	if curValBool == nil then
	CameraValInputD:show()
 	CameraValInputD:value(cCameraValueItem)
 	else
 	CameraValInputC:show()
 	CameraValInputC:value(cCameraValueItem)
 	end
 	end
 	
		
end  -- <5
end -- > 1
end

fltk_update()
end

-- end PickedCameraAttribute --} {}
  code {-- RenameCamera
function RenameCamera(w)
nName = tostring(w:value())
changeCameraVal(nName)
updateCameraListBrowser("updateCameraListBrowser")
PickedCameraAttribute(CameraFieldValues[2])
				
end} {}
  code {-- updateMaterialsTables

function updateMaterialsTables()
gSelectedMaterialAttributes={}
gSelectedMaterialValues={}
gSelectedMaterialData={} ; -- raw data
gSelectedMaterial = CameraFieldValues[8]
gselCameraMaterialsList ={}
	cMatList = ig3d_GetCameraMaterialsList_s_s(gObjName).."\\n"
	
	mcount = getlinecount(cMatList)
	if mcount == 0 and string.len(cMatList) ~= 0 then CameraMaterialsBrowser:add(cMatList) end
	
	for i =1,mcount,1 do
	linem=getlineof(cMatList,i)
	if linem ~= nil then
	table.insert(gselCameraMaterialsList,linem)
	
	end
	end
	
curmatinfo = ig3d_GetCameraMaterialInfo_si_s(gObjName , gSelectedMaterial).."\\n"				 

	for i = 1,getlinecount(curmatinfo),1 do
	curMatInfoLine = getlineof(curmatinfo,i)
		
		if curMatInfoLine ~= nil then 
		table.insert(gSelectedMaterialData,curMatInfoLine)
		
		if i == 1 then curMatInfoLine = "name="..curMatInfoLine end
		if i == 2 then curMatInfoLine = "lines="..curMatInfoLine end
		
		fe = string.find(curMatInfoLine,"=")
			if fe ~= nil  then 
				attrb = string.sub(curMatInfoLine,1,fe-1)
				values = string.sub(curMatInfoLine,fe+1,-1)
		
			if attrb ~= nil then table.insert(gSelectedMaterialAttributes,attrb) end
			
			if i == 1 and values == nil then 
			values =  gselCameraMaterialsList[gSelectedMaterial]
			end
			if values ~= nil then table.insert(gSelectedMaterialValues,values) end;
		 	end
		end
	end
end} {}
  code {-- updateMaterialBrowsers
function updateMaterialBrowsers()
CameraBrowserValueCatch()
CameraBrowserGroupsHide()
	updateMaterialsTables()
CameraMaterialsAttributesBrowser:clear()
CameraMaterialsValuesBrowser:clear()
CameraMaterialsBrowser:clear()

if \#gSelectedMaterialValues == nil then return end
	for i=1,\#gSelectedMaterialValues,1 do
	values= gSelectedMaterialValues[i]
				if tonumber(values) ~= 0 then
				for z in string.gmatch(values,"00") do
				values = string.gsub(values,"000","0")
				end
				end				
	CameraMaterialsValuesBrowser:add(values)
	end
	if \#gSelectedMaterialAttributes == nil then return end

	for i=1,\#gSelectedMaterialAttributes,1 do
	CameraMaterialsAttributesBrowser:add(gSelectedMaterialAttributes[i])
	end	
	
	for i=1,\#gselCameraMaterialsList,1 do
	CameraMaterialsBrowser:add(gselCameraMaterialsList[i]);
	end
	CameraMaterialsAttributesBrowser:select(CameraFieldValues[9])
	CameraMaterialsValuesBrowser:select(CameraFieldValues[9])
	CameraMaterialsBrowser:select(CameraFieldValues[8])
	CameraMaterialsAttributesBrowser:value(CameraFieldValues[9])
	CameraMaterialsValuesBrowser:value(CameraFieldValues[9])
	CameraMaterialsBrowser:value(CameraFieldValues[8])
	CameraMaterialsAttributesBrowser:selected(CameraFieldValues[9],CameraFieldValues[9])
	CameraMaterialsValuesBrowser:selected(CameraFieldValues[9],CameraFieldValues[9])
	CameraMaterialsBrowser:selected(CameraFieldValues[8],CameraFieldValues[8])
	
	
end} {}
