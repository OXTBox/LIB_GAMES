  code {-- PickedCameraMaterialsAttribute
function PickedMaterialsAttribute(n)
if CameraBrowser == nil then return end;
CameraBrowserValueCatch()
if n == nil then n = CameraFieldValues[9] end
if n == nil then return end

gSelectedCameraInfo = CurCameraInfo()             
CameraBrowserGroupsHide()		



if gCameraToolTipPicked =="materials" then 
	CameraMaterialsGroup:show()
	CameraMaterialsInputGroup:show() 
	CameraMaterialsNameInput:hide()
	CameraMaterialsValInputA:hide()
	
	if n == 1 or CameraFieldValues[9] == 1 then 
	-- Camera NAME
		CameraMaterialsValInputA:hide()
		CameraMaterialsValInputB:hide()
		CameraMaterialsValInputC:hide()
		CameraMaterialsValInputD:hide()
	CameraMaterialsInputGroup:show()  
	CameraMaterialsNameInput:show()
	CameraMaterialsNameInput:value(gSelectedMaterialValues[1])
	CameraMaterialsValInputA:hide()
	end



	
if n > 1 then 

	gCameraMaterialsValueItems={}
	curVal = gSelectedMaterialValues[n]
	curValBool=curVal
	curValF=""
	sstr = nil
	-- COMMAS
	if curVal ~= nil then 
	fc=string.find(curVal,",")
		if fc == nil then 
		
		table.insert(gCameraMaterialsValueItems,curVal)
		else
			for i = 1, numberofitems(curVal,","), 1 do
			local va=item(i,curVal,",")
			
			table.insert(gCameraMaterialsValueItems,va)
			end
		end
		
	end	

if \#gCameraMaterialsValueItems == 1 then 
		CameraMaterialsValInputA:hide()
		CameraMaterialsValInputB:hide()
		CameraMaterialsValInputC:hide()
		CameraMaterialsValInputD:hide()
		end
		
	if string.find(colorfulMaterialAtt,gSelectedMaterialAttributes[n]) ~= nil then 
	gRed = gCameraMaterialsValueItems[1]
	gGreen = gCameraMaterialsValueItems[2]
	gBlue = gCameraMaterialsValueItems[3]
	end
	

-- BOOLS
curValBool = tostring(gCameraMaterialsValueItems[1])
	if curValBool == "true" then
	CameraMaterialsBoolBtn:value(1)
	else
	CameraMaterialsBoolBtn:value(0)
	end
	
	if curValBool == "true" or curValBool == "false" then 	
	CameraMaterialsBoolBtn:show()
	CameraMaterialsBoolBtn:label(gSelectedMaterialAttributes[n])		
	else
	CameraMaterialsBoolBtn:hide()
	
		
	
	
for i=1,\#gCameraMaterialsValueItems,1 do
cCameraValueItem = tonumber(gCameraMaterialsValueItems[i])
  	if i == 1 then
 	CameraMaterialsValInputA:show()
 	CameraMaterialsValInputA:value(cCameraValueItem)
 	end
 
	if i == 2 then 
	CameraMaterialsValInputB:show()
 	CameraMaterialsValInputB:value(cCameraValueItem)
 	end
 
	if i == 3 then 
	CameraMaterialsValInputC:show()
 	CameraMaterialsValInputC:value(cCameraValueItem)
 	end
 	
	if i == 4 then 
	CameraMaterialsValInputD:show()
 	CameraMaterialsValInputD:value(cCameraValueItem)
 	end
 	end
 		
end  -- <5
end -- > 1

end



fltk_update()
end

-- end PickedCameraAttribute --} {}
