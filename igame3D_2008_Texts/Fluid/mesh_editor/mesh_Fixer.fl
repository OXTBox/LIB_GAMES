      }
      Fl_Input ysize {
        label {y-size}
        callback handleScaleValueFields
        xywh {95 108 60 19} type Float labelsize 10 align 1 textsize 10
      }
      Fl_Input zsize {
        label {z-size}
        callback handleScaleValueFields
        xywh {155 108 60 19} type Float labelsize 10 align 1 textsize 10
      }
      Fl_Group MeshAlign {
        label {Alignment Size}
        xywh {93 151 277 26} labelsize 10 align 4
      } {
        Fl_Button {} {
          label Align
          callback alignIt
          xywh {164 152 50 21} labelsize 10
        }
        Fl_Value_Input alignSize {
          xywh {95 153 60 19} labelsize 9 maximum 32 step 0.1 value 4 textsize 10
        }
      }
      Fl_Group extrudegroup {
        xywh {18 129 203 19}
      } {
        Fl_Button {} {
