gMapFile = gameroot.."Data/Levels/"..gMapName.."/"..gMapName.."mapXY.lua"
gMapMeshPath = gameroot.."Data/Levels/"..gMapName.."/"..gMapName.."map_mesh.wtf"



MapSavePathsBrowser:clear()
